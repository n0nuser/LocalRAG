OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=gemma3:4b

# Embedding provider. Ollama is the offline default. The optional local provider
# requires `uv sync --extra embedding`.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_SECONDS=120
SENTENCE_TRANSFORMERS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Ingestion-only vector cache. Disabled by default. It stores no source text or
# metadata; entries are provider/model/revision/preprocessing/dimension keyed.
EMBEDDING_CACHE_ENABLED=false
EMBEDDING_CACHE_PATH=./data/embedding-cache
EMBEDDING_CACHE_MAX_ENTRIES=10000
EMBEDDING_CACHE_MAX_BYTES=1000000000
EMBEDDING_CACHE_PREPROCESSING_VERSION=1
EMBEDDING_CACHE_TASK_PREFIX=

# Generation sampling. Unset = Ollama's per-model defaults. Set both (e.g.
# LLM_TEMPERATURE=0.0, LLM_SEED=42) to make answers reproducible across runs —
# what the eval suite does. See docs/reproducibility.md.
# LLM_TEMPERATURE=0.0
# LLM_SEED=42
LLM_TIMEOUT_SECONDS=180

# Eval run seed (down-sampling + judge sampling), read directly from the
# environment rather than Settings. Precedence: --seed CLI flag > this var >
# built-in default (42). See docs/reproducibility.md.
# EVAL_SEED=42

# Optional MLflow mirror for canonical evaluation/matrix JSON. Disabled by
# default; install with `uv sync --extra tracking`. JSON remains authoritative.
# EVAL_TRACKING_ENABLED=false
# EVAL_TRACKING_URI=file:./evals/tracking
# EVAL_TRACKING_EXPERIMENT=localrag-evaluations
# EVAL_TRACKING_CAPTURE_CONTENT=false
# EVAL_TRACKING_RETRIES=1

CHROMA_PERSIST_PATH=./data/chroma
CHROMA_COLLECTION_NAME=localrag

# Optional tenant tag written to every chunk's metadata and usable as a
# QueryRequest.metadata_filter key ({"tenant_id": "..."}). Empty = untagged
# (single-tenant deployments, the common case, pay zero extra cost). NOTE:
# this is an equality-filter convenience, not full multi-tenant isolation —
# see docs/rag-retrieval.md.
TENANT_ID=

CHUNK_CHARS=512
CHUNK_OVERLAP_CHARS=150
# fixed | structural | recursive (recursive uses paragraph/line/word separators)
CHUNKING_MODE=structural
CHUNK_MAX_CHARS=1200
CHUNK_MIN_CHARS=200
EMBEDDING_BATCH_SIZE=32

INGEST_RECURSIVE=true
INGEST_ROOTS=[]

# POST /ingest/upload destination and size cap (bypasses INGEST_ROOTS; the
# server picks the destination under UPLOAD_DIR).
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_BYTES=100000000
UPLOAD_RETENTION_SECONDS=0
UPLOAD_QUOTA_BYTES=1000000000

# Append-only local audit trail (one JSON line per query: question, sources, answer, model, latency). Empty disables.
AUDIT_LOG_PATH=
AUDIT_LOG_MAX_BYTES=10000000
AUDIT_LOG_RETENTION_SECONDS=2592000
AUDIT_LOG_METADATA_ONLY=false
AUDIT_LOG_REDACT_CONTENT=false

# OCR fallback for scanned/image-only PDF pages (requires the `tesseract` binary
# on the host; see docs/ocr.md). Set OCR_ENABLED=false to disable.
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_MIN_CHARS_PER_PAGE=20

RAG_TOP_K=5
# Installed retriever plugin ID. `builtin` preserves the default retriever.
RETRIEVER_PLUGIN=builtin
# Below this top-context score, refuse instead of generating (0 disables).
RAG_MIN_CONTEXT_SCORE=0.0
RETRIEVAL_MODE=hybrid
BM25_WEIGHT=0.5
RRF_K=60
FRESHNESS_HALF_LIFE_DAYS=30.0
# Weight recency carries in hybrid fusion, taken out of the relevance budget.
# Recency joins RRF as its own ranked list, so it breaks near-ties without
# overturning a clearly better match. Set 0 (or FRESHNESS_HALF_LIFE_DAYS=0) to
# rank on relevance alone.
FRESHNESS_WEIGHT=0.15
# Expand top retrieval hits to their full markdown section (via heading_path) before prompting. Set false to disable.
PARENT_EXPANSION_ENABLED=true
# LLM rewrites the query for retrieval only (adds one extra LLM round-trip per query); the original question is still used for the final answer prompt.
QUERY_REWRITE_ENABLED=false
# One bounded LLM call generates retrieval alternatives after rewriting (if enabled).
# The original question is always one retrieval variant. Hard caps are 8 variants,
# 500 chars/query, and 100 candidates across the variant fan-out.
QUERY_EXPANSION_ENABLED=false
QUERY_EXPANSION_MAX_VARIANTS=4
QUERY_EXPANSION_MAX_QUERY_CHARS=500
QUERY_EXPANSION_CANDIDATE_BUDGET=40
# Explicit retrieval experiment arm: auto, baseline, rewrite, hyde, rewrite+hyde.
RETRIEVAL_EXPERIMENT_MODE=auto
HYDE_ENABLED=false
HYDE_MODEL=
HYDE_TIMEOUT_SECONDS=30
HYDE_INPUT_MAX_CHARS=2000
HYDE_OUTPUT_MAX_CHARS=4000
HYDE_OUTPUT_MAX_TOKENS=512
# BM25 remains lexical and uses original by default; set rewritten only for a measured arm.
HYDE_LEXICAL_INPUT=original
HYDE_LOG_CONTENT=false
# Bounded adaptive evidence policy; disabled preserves fixed single-shot RAG.
ADAPTIVE_ENABLED=false
ADAPTIVE_INITIAL_TOP_K=3
ADAPTIVE_ESCALATION_TOP_K=8
ADAPTIVE_MAX_ROUNDS=3
ADAPTIVE_MAX_REFINEMENTS=1
ADAPTIVE_MAX_LATENCY_MS=10000
# Corpus-tuned heuristic signals, not calibrated LLM confidence.
ADAPTIVE_MIN_TOP_SCORE=0.35
ADAPTIVE_MIN_SCORE_MARGIN=0.02
ADAPTIVE_MIN_SOURCE_DIVERSITY=1
ADAPTIVE_MIN_QUERY_COVERAGE=0.2
ADAPTIVE_REFINEMENT_MAX_CHARS=500
ADAPTIVE_CRITIQUE_ENABLED=false
ADAPTIVE_MAX_PROVIDER_CALLS=2
RAG_SYSTEM_PROMPT=You are a helpful assistant. Answer only based on the provided context.

# Optional cross-encoder reranking (requires `uv sync --extra rerank`).
RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_FETCH_K=20

# Deterministic extractive compression after reranking, freshness, and parent expansion.
# Disabled by default. Budgets use whitespace-token accounting; code fences and tables are indivisible.
CONTEXT_COMPRESSION_ENABLED=false
CONTEXT_COMPRESSION_CANDIDATE_COUNT=20
CONTEXT_COMPRESSION_MAX_CONTEXTS=5
CONTEXT_COMPRESSION_PER_CONTEXT_TOKENS=256
CONTEXT_COMPRESSION_TOTAL_TOKENS=1024
CONTEXT_COMPRESSION_PER_CONTEXT_CHARS=4000
CONTEXT_COMPRESSION_TOTAL_CHARS=16000
LLM_CONTEXT_WINDOW_TOKENS=4096
CONTEXT_COMPRESSION_RESERVED_PROMPT_TOKENS=512
CONTEXT_COMPRESSION_RESERVED_ANSWER_TOKENS=512

# In-process TTL cache for repeated/near-identical queries (0 disables; no external cache).
QUERY_CACHE_TTL_SECONDS=0
QUERY_CACHE_MAXSIZE=256

API_HOST=0.0.0.0
API_PORT=8000

# Set to a non-empty string to require X-API-Key header on all non-health endpoints.
# Leave empty to disable authentication (default).
API_KEY=

# LLM backend: ollama | openai | anthropic
LLM_BACKEND=ollama

# Optional automatic failover backend when the primary trips its circuit breaker
# (ollama | openai | anthropic; empty disables fallback).
# Optional failover provider. Must differ from LLM_BACKEND.
LLM_FALLBACK_BACKEND=
LLM_RETRY_MAX_ATTEMPTS=3
LLM_CIRCUIT_FAIL_MAX=5
LLM_CIRCUIT_RESET_TIMEOUT_SECONDS=30.0

# OpenAI provider (only used when LLM_BACKEND=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic provider (only used when LLM_BACKEND=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Agent settings (POST /agent/query — uses Anthropic tool-use)
AGENT_MODEL=claude-haiku-4-5

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional OpenTelemetry tracing. Install with `uv sync --extra observability`.
# Disabled and content-free by default; use a local trusted OTLP collector only.
OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=localrag
OTEL_SAMPLE_RATE=1.0
OTEL_EXPORTER_TIMEOUT_SECONDS=10.0
OTEL_EXPORTER_RETRY_COUNT=3
OTEL_CAPTURE_CONTENT=false
OTEL_MAX_ATTRIBUTE_LENGTH=256
# Langfuse is a separate optional product adapter and is not used by core RAG.
# Install `uv sync --extra langfuse` only for a future explicitly configured adapter.
LANGFUSE_ENABLED=false

# Optional structured configuration. Use `uv run localrag --config config.yaml ...`
# or set LOCALRAG_CONFIG for API startup. YAML is below .env and process env in
# precedence; secrets belong in environment variables, not committed YAML.
# LOCALRAG_CONFIG=./config.yaml
